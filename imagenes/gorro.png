</span><span></span><span class="token" style="color: rgb(80, 161, 79);">.menu</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">position</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> fixed</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">top</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 0</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">left</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 0</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">width</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 100%</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">z-index</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 1000</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>                 </span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* para que quede por encima del carrusel */</span><span>
