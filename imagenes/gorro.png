</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">height</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 100%</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span><span>
</span>
<span></span><span class="token" style="color: rgb(80, 161, 79);">.carousel-item img</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">height</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 100%</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">width</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 100%</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">object-fit</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> cover</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>      </span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* Recorta la imagen sin deformarla */</span><span>
