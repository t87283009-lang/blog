</span><span>    </span><span class="token" style="color: rgb(56, 58, 66);">&lt;</span><span class="token" style="color: rgb(228, 86, 73);">span</span><span class="token" style="color: rgb(228, 86, 73);"> </span><span class="token" style="color: rgb(183, 107, 1);">class</span><span class="token" style="color: rgb(56, 58, 66);">=</span><span class="token" style="color: rgb(56, 58, 66);">"</span><span class="token" style="color: rgb(80, 161, 79);">carousel-control-prev-icon</span><span class="token" style="color: rgb(56, 58, 66);">"</span><span class="token" style="color: rgb(56, 58, 66);">&gt;</span><span class="token" style="color: rgb(56, 58, 66);">&lt;/</span><span class="token" style="color: rgb(228, 86, 73);">span</span><span class="token" style="color: rgb(56, 58, 66);">&gt;</span><span>
