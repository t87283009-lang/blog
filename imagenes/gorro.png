</span><span></span><span class="token" style="color: rgb(80, 161, 79);">#carouselExample,
</span><span class="token" style="color: rgb(80, 161, 79);">.carousel-item,
</span><span class="token" style="color: rgb(80, 161, 79);">.carousel-item img</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">height</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 100vh</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>           </span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* 100% de la altura de la ventana */</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">object-fit</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> cover</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">object-position</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> center</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span><span>
</span>
<span></span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* Menú transparente arriba (estilo San Carbón) */</span><span>
</span><span></span><span class="token" style="color: rgb(80, 161, 79);">.navbar</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">background-color</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> </span><span class="token" style="color: rgb(64, 120, 242);">rgba</span><span class="token" style="color: rgb(56, 58, 66);">(</span><span>0</span><span class="token" style="color: rgb(56, 58, 66);">,</span><span> 0</span><span class="token" style="color: rgb(56, 58, 66);">,</span><span> 0</span><span class="token" style="color: rgb(56, 58, 66);">,</span><span> 0.5</span><span class="token" style="color: rgb(56, 58, 66);">)</span><span> </span><span class="token" style="color: rgb(228, 86, 73);">!important</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span> </span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* semi-transparente */</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">padding-top</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 15px</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">padding-bottom</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 15px</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span><span>
</span>
<span></span><span class="token" style="color: rgb(80, 161, 79);">.navbar-brand,
</span><span class="token" style="color: rgb(80, 161, 79);">.nav-link</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">color</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> white </span><span class="token" style="color: rgb(228, 86, 73);">!important</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">font-weight</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 500</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span><span>
</span>
<span></span><span class="token" style="color: rgb(80, 161, 79);">.nav-link:hover</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">color</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> #ffc107 </span><span class="token" style="color: rgb(228, 86, 73);">!important</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span> </span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* color al pasar el mouse */</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span><span>
</span>
<span></span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* Texto sobre el carrusel */</span><span>
</span><span></span><span class="token" style="color: rgb(80, 161, 79);">.carousel-caption</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">bottom</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 20%</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">background</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> </span><span class="token" style="color: rgb(64, 120, 242);">rgba</span><span class="token" style="color: rgb(56, 58, 66);">(</span><span>0</span><span class="token" style="color: rgb(56, 58, 66);">,</span><span> 0</span><span class="token" style="color: rgb(56, 58, 66);">,</span><span> 0</span><span class="token" style="color: rgb(56, 58, 66);">,</span><span> 0.4</span><span class="token" style="color: rgb(56, 58, 66);">)</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">padding</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 20px</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">border-radius</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 10px</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span><span>
</span>
<span></span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* Espacio para que el contenido de abajo no quede tapado por el menú */</span><span>
</span><span></span><span class="token" style="color: rgb(80, 161, 79);">.contenido-abajo</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">padding-top</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 40px</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span></code></pre></div></div><hr style="margin-top: 3em; margin-bottom: 3em; border-color: rgb(185, 202, 211);"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-adyw6z r-135wba7 r-b88u0q" style="display: block; direction: ltr; margin-top: 1.5em; margin-bottom: 0.5em;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">Resultado que vas a obtener:</span></span></span></span><ul dir="ltr" style="display: block; padding-inline-start: 2em; list-style-type: disc; margin-block: 0px 1.25em;"><li style="font-family: TwitterChirp, System; margin-top: 0px;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">El carrusel ocupa </span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-b88u0q r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">toda la pantalla</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"> al cargar (como San Carbón).</span></span></span></li><li style="font-family: TwitterChirp, System; margin-top: 0.5em;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">El menú queda </span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-b88u0q r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">fijo arriba</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"> y semi-transparente.</span></span></span></li><li style="font-family: TwitterChirp, System; margin-top: 0.5em;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">Cuando haces scroll, aparece el resto de tu página (Tiempo, Cuidado, Paciencia, etc.).</span></span></span></li></ul><hr style="margin-top: 3em; margin-bottom: 3em; border-color: rgb(185, 202, 211);"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1adg3ll r-1x3r274 r-p1pxzi" style="direction: ltr;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-b88u0q r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">¿Quieres que te dé la versión completa</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"> (con el menú + carrusel + tu sección de abajo ya armada)?</span></span><br><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">Solo dime y te la armo lista para copiar y pegar.</span></span></span></span></div></div></div></div><div class="css-g5y9jx r-18u37iz r-1wtj0ep r-1s2bzr4 r-11niif6 r-1udh08x r-3o4zer r-bnwqim r-13qz1uu"><div class="css-g5y9jx r-1habvwh r-1h0z5md"><div class="css-g5y9jx r-1awozwy r-18u37iz r-1wtj0ep r-13qz1uu"><div class="cs