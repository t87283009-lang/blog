</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">width</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 100%</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">margin</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 0</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">padding</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 0</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span><span>
</span>
