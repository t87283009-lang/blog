px; font-size: 13px; display: block; width: 100%; box-sizing: border-box;"><code class="language-html" style="background: rgb(250, 250, 250); color: rgb(56, 58, 66); font-family: &quot;Fira Code&quot;, &quot;Fira Mono&quot;, Menlo, Consolas, &quot;DejaVu Sans Mono&quot;, monospace; direction: ltr; text-align: left; white-space: pre; word-spacing: normal; word-break: normal; line-height: 1.5; tab-size: 2; hyphens: none;"><span class="token" style="color: rgb(56, 58, 66);">&lt;</span><span class="token" style="color: rgb(228, 86, 73);">script</span><span class="token" style="color: rgb(228, 86, 73);"> </span><span class="token" style="color: rgb(183, 107, 1);">src</span><span class="token" style="color: rgb(56, 58, 66);">=</span><span class="token" style="color: rgb(56, 58, 66);">"</span><span class="token" style="color: rgb(80, 161, 79);">https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js</span><span class="token" style="color: rgb(56, 58, 66);">"</span><span class="token" style="color: rgb(56, 58, 66);">&gt;</span><span class="token" style="color: rgb(56, 58, 66);">&lt;/</span><span class="token" style="color: rgb(228, 86, 73);">script</span><span class="token" style="color: rgb(56, 58, 66);">&gt;</span></code></pre></div></div><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-adyw6z r-135wba7 r-b88u0q" style="display: block; direction: ltr; margin-top: 1.5em; margin-bottom: 0.5em;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">2. Ajustes recomendados en tu CSS (estilos.css)</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1adg3ll r-1g7jtus r-1x3r274" style="direction: ltr;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">Tu regla actual está bien, pero la mejoramos un poco para que se vea más profesional y se adapte mejor a diferentes pantallas:</span></span></span></span><div class="css-g5y9jx r-1adg3ll r-ag158w r-dnmrzs r-1yx7oqi r-13qz1uu"><div class="css-g5y9jx r-dnmrzs r-1adg3ll r-13qz1uu" data-testid="markdown-code-block"><div class="css-g5y9jx r-1awozwy r-bqz1g2 r-iimx8d r-10ergbs r-6413gk r-43g30s r-l4nmg1 r-o59np7 r-2dysd3 r-vmopo1 r-13qz1uu r-gtdqiz r-1fhadnw r-184en5c"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-1aiqnjv r-n6v787"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">css</span></span><div class="css-g5y9jx r-1awozwy r-6koalj r-18u37iz r-z5qs1h r-17s6mgv"><button aria-label="Copy to clipboard" role="button" class="css-g5y9jx r-xoduu5 r-sdzlij r-1phboty r-rs99b7 r-lrvibr r-1ceczpf r-lp5zef r-1loqt21 r-o7ynqc r-6416eg r-1ny4l3l" type="button" style="background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0);"><span class="css-1jxf684 r-qvutc0 r-poiln3 r-q4m81j r-b88u0q r-1awozwy r-6koalj r-18u37iz r-16y2uox r-bcqeeo r-1777fci" style="color: rgb(15, 20, 25);"><svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-10ptun7 r-1janqcz" style="color: rgb(15, 20, 25);"><g><path d="M19.5 2C20.88 2 22 3.12 22 4.5v11c0 1.21-.86 2.22-2 2.45V4.5c0-.28-.22-.5-.5-.5H6.05c.23-1.14 1.24-2 2.45-2h11zm-4 4C16.88 6 18 7.12 18 8.5v11c0 1.38-1.12 2.5-2.5 2.5h-11C3.12 22 2 20.88 2 19.5v-11C2 7.12 3.12 6 4.5 6h11zM4 19.5c0 .28.22.5.5.5h11c.28 0 .5-.22.5-.5v-11c0-.28-.22-.5-.5-.5h-11c-.28 0-.5.22-.5.5v11z"></path></g></svg><div class="css-g5y9jx r-xoduu5"><span class="css-1jxf684 r-dnmrzs r-1udh08x r-1udbk01 r-3s2u2q r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1b43r93 r-1cwl3u0" style="border-bottom: 2px solid rgb(15, 20, 25);"></span></div></span></button></div></div><pre style="background: rgb(247, 249, 249); color: rgb(56, 58, 66); font-family: monospace; direction: ltr; text-align: left; white-space: pre; word-spacing: normal; word-break: normal; line-height: 1.3; tab-size: 2; hyphens: none; padding: 12px; margin: 0px 0px 0.5em; overflow: auto; border-radius: 0.3em 0.3em 8px 8px; font-size: 13px; display: block; width: 100%; box-sizing: border-box;"><code class="language-css" style="background: rgb(250, 250, 250); color: rgb(56, 58, 66); font-family: &quot;Fira Code&quot;, &quot;Fira Mono&quot;, Menlo, Consolas, &quot;DejaVu Sans Mono&quot;, monospace; direction: ltr; text-align: left; white-space: pre; word-spacing: normal; word-break: normal; line-height: 1.5; tab-size: 2; hyphens: none;"><span class="token" style="color: rgb(80, 161, 79);">.carousel-item img</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">height</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 450px</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>          </span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* Puedes subir o bajar este valor según te guste */</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">object-fit</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> cover</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>      </span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* Recorta la imagen sin deformarla */</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">object-position</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> center</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span> </span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* Centra el recorte */</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">width</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 100%</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span><span>
</span>
<span></span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* Opcional: hace que el carrusel no se vea tan alto en móviles */</span><span>
</span><span></span><span class="token" style="color: rgb(183, 107, 1);">@media</span><span class="token" style="color: rgb(183, 107, 1);"> </span><span class="token" style="color: rgb(56, 58, 66);">(</span><span class="token" style="color: rgb(228, 86, 73);">max-width</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span class="token" style="color: rgb(183, 107, 1);"> 768px</span><span class="token" style="color: rgb(56, 58, 66);">)</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(80, 161, 79);">.carousel-item img</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
