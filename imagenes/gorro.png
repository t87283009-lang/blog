</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">padding</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 12px 0</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span><span>
</span>
<span></span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* Si quieres que el texto del menú sea blanco */</span><span>
