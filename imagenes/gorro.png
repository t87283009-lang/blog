</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">margin</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 0 auto</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>           </span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* Centrado horizontal */</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">padding-left</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 15px</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">padding-right</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 15px</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span><span>
</span>
<span></span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* Si usas tarjetas (las de Terapia, Compañía, etc.) */</span><span>
</span><span></span><span class="token" style="color: rgb(80, 161, 79);">.card, .tarjeta</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>           </span><span class="token" style="color: rgb(160, 161, 167); font-style: italic;">/* cambia .tarjeta por la clase que uses */</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">border-radius</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 12px</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">box-shadow</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 0 4px 12px </span><span class="token" style="color: rgb(64, 120, 242);">rgba</span><span class="token" style="color: rgb(56, 58, 66);">(</span><span>0</span><span class="token" style="color: rgb(56, 58, 66);">,</span><span>0</span><span class="token" style="color: rgb(56, 58, 66);">,</span><span>0</span><span class="token" style="color: rgb(56, 58, 66);">,</span><span>0.1</span><span class="token" style="color: rgb(56, 58, 66);">)</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">transition</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> transform 0.3s</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">height</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> 100%</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span><span>
</span>
<span></span><span class="token" style="color: rgb(80, 161, 79);">.card:hover</span><span> </span><span class="token" style="color: rgb(56, 58, 66);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(228, 86, 73);">transform</span><span class="token" style="color: rgb(56, 58, 66);">:</span><span> </span><span class="token" style="color: rgb(64, 120, 242);">translateY</span><span class="token" style="color: rgb(56, 58, 66);">(</span><span>-5px</span><span class="token" style="color: rgb(56, 58, 66);">)</span><span class="token" style="color: rgb(56, 58, 66);">;</span><span>
</span><span></span><span class="token" style="color: rgb(56, 58, 66);">}</span></code></pre></div></div><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-adyw6z r-135wba7 r-b88u0q" style="display: block; direction: ltr; margin-top: 1.5em; margin-bottom: 0.5em;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">3. Si tienes una cuadrícula de tarjetas (como en la última captura)</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1adg3ll r-1g7jtus r-1x3r274" style="direction: ltr;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">Usa el sistema de Bootstrap para que queden bien ordenadas:</span></span></span></span><div class="css-g5y9jx r-1adg3ll r-ag158w r-dnmrzs r-1yx7oqi r-13qz1uu"><div class="css-g5y9jx r-dnmrzs r-1adg3ll r-13qz1uu" data-testid="markdown-code-block"><div class="css-g5y9jx r-1awozwy r-bqz1g2 r-iimx8d r-10ergbs r-6413gk r-43g30s r-l4nmg1 r-o59np7 r-2dysd3 r-vmopo1 r-13qz1uu r-gtdqiz r-1fhadnw r-184en5c"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-1aiqnjv r-n6v787"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">html</span></span><div class="css-g5y9jx r-1awozwy r-6koalj r-18u37iz r-z5qs1h r-17s6mgv"><button aria-label="Copy to clipboard" role="button" class="css-g5y9jx r-xoduu5 r-sdzlij r-1phboty r-rs99b7 r-lrvibr r-1ceczpf r-lp5zef r-1loqt21 r-o7ynqc r-6416eg r-1ny4l3l" type="button" style="background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0);"><span class="css-1jxf684 r-qvutc0 r-poiln3 r-q4m81j r-b88u0q r-1awozwy r-6koalj r-18u37iz r-16y2uox r-bcqeeo r-1777fci" style="color: rgb(15, 20, 25);"><svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo 